DATABASE_PASSWORD=replace-with-a-strong-local-password
JWT_SECRET=replace-with-at-least-48-random-characters
GRAFANA_PASSWORD=replace-for-shared-environments
VITE_API_BASE_URL=http://localhost:8085/api/v1
FRONTEND_PORT=8080
# SMTP is disabled until EMAIL_ENABLED=true and these settings are supplied.
EMAIL_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_FROM=no-reply@example.com
# Cookie policy: Lax is correct for same-site frontend/API deployments. Use None only over HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_DOMAIN=
# Local attachments are the default. Use the MinIO override for an S3-compatible staging setup.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./data/attachments
S3_BUCKET=focusflow-attachments
AWS_REGION=ap-southeast-1
S3_ENDPOINT=
MINIO_ROOT_USER=focusflow-local
MINIO_ROOT_PASSWORD=replace-with-a-minimum-8-character-password
